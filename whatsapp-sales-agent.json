            "id": "4b68ce9d-5ac2-4bb3-9c86-efdbb7cbfce1",
            "name": "Webhook Evolution",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                0,
                0
            ],
            "webhookId": "whatsapp-bot-inbox"
        },
        {
            "parameters": {
                "rules": {
                    "values": [
                        {
                            "conditions": {
                                "options": {
                                    "caseSensitive": true,
                                    "leftValue": "",
                                    "typeValidation": "strict"
                                },
                                "conditions": [
                                    {
                                        "leftValue": "={{ $json.body?.data?.fromMe || false }}",
                                        "rightValue": false,
                                        "operator": {
                                            "type": "boolean",
                                            "operation": "false",
                                            "singleValue": true
                                        }
                                    }
                                ],
                                "combinator": "and"
                            },
                            "renameOutput": true,
                            "outputKey": "Permitido"
                        }
                    ]
                },
                "fallbackOutput": 1
            },
            "id": "e72bd5a3-7186-4e5c-a5b8-5cfbe3685e13",
            "name": "Ignorar o Próprio Bot",
            "type": "n8n-nodes-base.switch",
            "typeVersion": 3,
            "position": [
                220,
                0
            ]
        },
        {
            "parameters": {
                "jsCode": "const msgData = $input.item.json.body?.data || {};\nlet finalMessage = \"\";\nlet hasMedia = false;\nlet mediaType = \"none\";\nlet base64Media = \"\";\n\nif (msgData.messageType === \"audioMessage\") {\n    hasMedia = true;\n    mediaType = \"audio\";\n    base64Media = msgData.message?.base64 || \"\";\n} else if (msgData.messageType === \"imageMessage\") {\n    hasMedia = true;\n    mediaType = \"image\";\n    base64Media = msgData.message?.base64 || \"\";\n} else {\n    finalMessage = msgData.message?.conversation || msgData.message?.extendedTextMessage?.text || \"\";\n}\n\n// Extrai apenas os numeros do remoteJid (11999999999@s.whatsapp.net)\nconst number = (msgData.remoteJid || \"\").replace(/[^0-9]/g, '');\n\nreturn {\n    remoteId: msgData.remoteJid || \"\",\n    number: number,\n    pushName: msgData.pushName || \"Cliente\",\n    message: finalMessage,\n    hasMedia: hasMedia,\n    mediaType: mediaType,\n    base64Media: base64Media\n};"
            },
            "id": "b1b7470f-5baf-4bd6-be0c-5d9c6e5e8c18",
            "name": "Parser da Mensagem",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                440,
                0
            ]
        },
        {
            "parameters": {
                "text": "={{ $json.message }}",
                "options": {
                    "systemMessage": "Você é o atendente virtual do Mercado do Vale (loja de celulares e tecnologia). Seu nome é Assistente Virtual e você fala diretamente com o cliente ({{ $('Parser da Mensagem').item.json.pushName }}).\n\nREGRAS:\n1. CHAME A FERRAMENTA 'checar_estoque' OBRIGATORIAMENTE se o cliente perguntar se tem um produto, preços ou o que temos na loja.\n2. Os valores vindos da ferramenta estão em centavos. Sempre divida por 100 para exibir em Reais (R$). (Ex: 10500 = R$ 105,00).\n3. Trate o usuário de forma amigável, educada e vendedora.\n4. Se o usuário mandar Foto/Áudio e não estiver transcrito, avise gentilmente \"Ainda estou aprendendo a ouvir áudios, poderia digitar por favor?\" (A não ser que os módulos extras de transcrição já estejam ativados no seu fluxo).\n5. NUNCA invente preços ou descontos. Seja direto nas respostas."
                }
            },
            "id": "e1f13a0e-0eb3-4903-b0df-26feee0b8528",
