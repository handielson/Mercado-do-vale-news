# .env.vps.example
# Template do /var/www/mdv-api/.env na VPS Hostinger (76.13.232.162).
# NÃO commitar o .env real — este arquivo existe só para documentar as chaves esperadas.
#
# Após alterar o .env na VPS: `pm2 restart all --update-env`.

# -----------------------------------------------------------------------------
# Synology NAS (acessado via Cloudflare Tunnel mdv-videos)
# -----------------------------------------------------------------------------
# IMPORTANTE: usar o hostname do tunnel, NÃO QuickConnect/IP local (192.168.x.x)
# — a VPS está fora da rede do NAS e não enxerga LAN.
SYNOLOGY_URL="https://dsm-api.xiaomipetrolina.com.br"
SYNOLOGY_USER="Handielson"
SYNOLOGY_PASS="TROCAR_PELA_SENHA_REAL"

# -----------------------------------------------------------------------------
# Segurança — compartilhado entre frontend (VITE_VPS_SYNC_KEY) e servidor VPS
# -----------------------------------------------------------------------------
SYNC_SECRET="TROCAR_POR_HEX_DE_64_CHARS"

# -----------------------------------------------------------------------------
# Admin padrão da autenticação VPS
# -----------------------------------------------------------------------------
# Usado no boot do Fastify para garantir um customer ADMIN + login em customer_auth.
MDV_ADMIN_EMAIL="admin@mercadodovale.com.br"
MDV_ADMIN_PASSWORD="TROCAR_ASSIM_QUE_ENTRAR"

# ---------------------------------------------------------------------------
# Auth por e-mail
# ---------------------------------------------------------------------------
# Desligado por padrao durante a migracao: ainda nao existem e-mails
# transacionais criados para confirmacao de cadastro ou recuperacao de senha.
VPS_AUTH_REQUIRE_EMAIL_CONFIRMATION="false"
VPS_AUTH_PASSWORD_RESET_TTL_MINUTES="60"
APP_PUBLIC_URL="https://www.mercadodovale.com.br"

# SMTP transacional usado pela recuperacao de senha e avisos de seguranca.
# Exemplo comum: porta 465 com SMTP_SECURE=true, ou porta 587 com STARTTLS.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_STARTTLS="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_FROM_NAME="Mercado do Vale"

# -----------------------------------------------------------------------------
# MySQL local da VPS (catálogo, pedidos, etc.)
# -----------------------------------------------------------------------------
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="mdv_api"
MYSQL_PASSWORD="TROCAR"
MYSQL_DATABASE="mdv"

# -----------------------------------------------------------------------------
# Bling (ERP)
# -----------------------------------------------------------------------------
BLING_CLIENT_ID=""
BLING_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Meta / Instagram Marketing API
# -----------------------------------------------------------------------------
# Defina explicitamente a versao ativa da Graph API cadastrada no app Meta.
META_GRAPH_API_VERSION=""
META_APP_ID=""
META_APP_SECRET=""
META_OAUTH_REDIRECT_URI="https://api.xiaomipetrolina.com.br/integrations/meta/oauth/callback"
# Segredo aleatorio exclusivo (recomendado: 64 caracteres hexadecimais).
# Ele criptografa o token Meta em repouso e nunca e enviado ao frontend.
META_TOKEN_ENCRYPTION_KEY=""
META_OAUTH_SCOPES="ads_read,ads_management,business_management,pages_show_list,pages_read_engagement,instagram_basic"

# -----------------------------------------------------------------------------
# Google Contacts / People API (AutoResponder contact save)
# -----------------------------------------------------------------------------
GOOGLE_CONTACTS_CLIENT_ID=""
GOOGLE_CONTACTS_CLIENT_SECRET=""
GOOGLE_CONTACTS_REFRESH_TOKEN=""

# -----------------------------------------------------------------------------
# Google OAuth exclusivo do login de clientes (nao reutilizar credenciais admin/n8n)
# -----------------------------------------------------------------------------
GOOGLE_LOGIN_CLIENT_ID=""
GOOGLE_LOGIN_CLIENT_SECRET=""
GOOGLE_LOGIN_REDIRECT_URI="https://api.xiaomipetrolina.com.br/auth/google/callback"

# -----------------------------------------------------------------------------
# Porta do Fastify (pm2: mdv-api)
# -----------------------------------------------------------------------------
PORT="3001"
NODE_ENV="production"

