# .env.example — front-end Vite (mercadodovale.com.br)
# Copie para .env.local (local) e configure no Vercel (produção / preview).

# Supabase
VITE_SUPABASE_URL="https://cqbdyxxzmkgeghwkozts.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# Modo dev (false em produção)
VITE_DEV_MODE="false"

# UUID fixo da empresa "Mercado do Vale".
# Quando definido, services/companyContext.ts dispensa o lookup
# /companies?slug=eq.mercado-do-vale e poupa ~3 chamadas Supabase no init.
VITE_COMPANY_ID="9717131e-7b14-4aec-84a4-4317c0489985"

# URL da API VPS (catálogo, pedidos)
VITE_VPS_API_URL="https://api.xiaomipetrolina.com.br"

# Chave compartilhada com a VPS (opcional — endpoints públicos não precisam)
VITE_VPS_SYNC_KEY=""
