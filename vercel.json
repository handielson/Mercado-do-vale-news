{
    "crons": [
        {
            "path": "/api/cron-dispatcher",
            "schedule": "0 22 * * *"
        }
    ],
    "rewrites": [
        {
            "source": "/api/auth/callback/bling",
            "destination": "/api/bling?resource=oauth-callback"
        },
        {
            "source": "/api/mercadopago-webhook",
            "destination": "/api/bling-webhook"
        },
        {
            "source": "/api/brasilapi-ncm",
            "destination": "/api/vps-proxy?brasilapi=ncm"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/sitemap.xml",
            "destination": "/api/sitemap"
        },
        {
            "source": "/produto/:slug",
            "destination": "/api/seo-produto?slug=:slug"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}
